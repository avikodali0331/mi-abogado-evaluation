e-color-left: var(--tt-line-color); --line-color-right: var(--tt-line-color); --line-color-top: var(--tt-line-color); --line-width-bottom: 0.05em; --line-width-left: 0.1em; --line-width-right: 0.1em; --line-width-top: 0.1em; --trim-bottom-left: 0%; --trim-bottom-right: 0%; --trim-left-bottom: 0%; --trim-left-top: 0%; --trim-right-bottom: 0%; --trim-right-top: 0%; --trim-top-left: 0%; --trim-top-right: 0%; ; text-align: left }\n    #tinytable_42rh2nychshpo8sinuoz td.tinytable_css_aqy0matnvnqmla5ny46g, #tinytable_42rh2nychshpo8sinuoz th.tinytable_css_aqy0matnvnqmla5ny46g { text-align: left }\n    #tinytable_42rh2nychshpo8sinuoz td.tinytable_css_yxyf5sfxhc2mnln7ugek, #tinytable_42rh2nychshpo8sinuoz th.tinytable_css_yxyf5sfxhc2mnln7ugek {  position: relative; --border-bottom: 1; --border-left: 0; --border-right: 0; --border-top: 1; --line-color-bottom: var(--tt-line-color); --line-color-left: var(--tt-line-color); --line-color-right: var(--tt-line-color); --line-color-top: var(--tt-line-color); --line-width-bottom: 0.05em; --line-width-left: 0.1em; --line-width-right: 0.1em; --line-width-top: 0.1em; --trim-bottom-left: 0%; --trim-bottom-right: 0%; --trim-left-bottom: 0%; --trim-left-top: 0%; --trim-right-bottom: 0%; --trim-right-top: 0%; --trim-top-left: 0%; --trim-top-right: 0%; ; text-align: left }\n    </style>\n    <div class=\"container\">\n      <table class=\"tinytable\" id=\"tinytable_42rh2nychshpo8sinuoz\" style=\"width: auto; margin-left: auto; margin-right: auto;\" data-quarto-disable-processing='true'>\n        \n        <thead>\n              <tr>\n                <th scope=\"col\" data-row=\"0\" data-col=\"1\"> </th>\n                <th scope=\"col\" data-row=\"0\" data-col=\"2\">Days Living with Family</th>\n              </tr>\n        </thead>\n        <tfoot><tr><td colspan='2'>+ p < 0.1, * p < 0.05, ** p < 0.01, *** p < 0.001</td></tr></tfoot>\n        <tbody>\n                <tr>\n                  <td data-row=\"1\" data-col=\"1\">(Intercept)</td>\n                  <td data-row=\"1\" data-col=\"2\">13.265***</td>\n                </tr>\n                <tr>\n                  <td data-row=\"2\" data-col=\"1\"></td>\n                  <td data-row=\"2\" data-col=\"2\">(0.258)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"3\" data-col=\"1\">Assigned to Mi Abogado (T)</td>\n                  <td data-row=\"3\" data-col=\"2\">0.099</td>\n                </tr>\n                <tr>\n                  <td data-row=\"4\" data-col=\"1\"></td>\n                  <td data-row=\"4\" data-col=\"2\">(0.279)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"5\" data-col=\"1\">Post-Randomization</td>\n                  <td data-row=\"5\" data-col=\"2\">-0.103</td>\n                </tr>\n                <tr>\n                  <td data-row=\"6\" data-col=\"1\"></td>\n                  <td data-row=\"6\" data-col=\"2\">(0.188)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"7\" data-col=\"1\">female</td>\n                  <td data-row=\"7\" data-col=\"2\">1.465***</td>\n                </tr>\n                <tr>\n                  <td data-row=\"8\" data-col=\"1\"></td>\n                  <td data-row=\"8\" data-col=\"2\">(0.180)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"9\" data-col=\"1\">age_groupUnder 12</td>\n                  <td data-row=\"9\" data-col=\"2\">-3.272***</td>\n                </tr>\n                <tr>\n                  <td data-row=\"10\" data-col=\"1\"></td>\n                  <td data-row=\"10\" data-col=\"2\">(0.176)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"11\" data-col=\"1\">regionMaule</td>\n                  <td data-row=\"11\" data-col=\"2\">0.272</td>\n                </tr>\n                <tr>\n                  <td data-row=\"12\" data-col=\"1\"></td>\n                  <td data-row=\"12\" data-col=\"2\">(0.285)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"13\" data-col=\"1\">regionMetropolitan</td>\n                  <td data-row=\"13\" data-col=\"2\">-0.076</td>\n                </tr>\n                <tr>\n                  <td data-row=\"14\" data-col=\"1\"></td>\n                  <td data-row=\"14\" data-col=\"2\">(0.247)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"15\" data-col=\"1\">regionValparaiso</td>\n                  <td data-row=\"15\" data-col=\"2\">0.205</td>\n                </tr>\n                <tr>\n                  <td data-row=\"16\" data-col=\"1\"></td>\n                  <td data-row=\"16\" data-col=\"2\">(0.272)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"17\" data-col=\"1\">Treatment x Post (ATE)</td>\n                  <td data-row=\"17\" data-col=\"2\">3.740***</td>\n                </tr>\n                <tr>\n                  <td data-row=\"18\" data-col=\"1\"></td>\n                  <td data-row=\"18\" data-col=\"2\">(0.366)</td>\n                </tr>\n                <tr>\n                  <td data-row=\"19\" data-col=\"1\">Num.Obs.</td>\n                  <td data-row=\"19\" data-col=\"2\">14968</td>\n                </tr>\n                <tr>\n                  <td data-row=\"20\" data-col=\"1\">R2</td>\n                  <td data-row=\"20\" data-col=\"2\">0.047</td>\n                </tr>\n                <tr>\n                  <td data-row=\"21\" data-col=\"1\">RMSE</td>\n                  <td data-row=\"21\" data-col=\"2\">10.18</td>\n                </tr>\n                <tr>\n                  <td data-row=\"22\" data-col=\"1\">Std.Errors</td>\n                  <td data-row=\"22\" data-col=\"2\">by: child_id</td>\n                </tr>\n        </tbody>\n      </table>\n    </div>\n<!-- hack to avoid NA insertion in last line -->\n```\n\n:::\n:::\n\n\n**Interpretation:** The coefficient on the interaction term represents the Average Treatment Effect (ATE). In our synthetic cohort, assignment to the Mi Abogado program increases the time a child spends living with their family by approximately 3.74 days per quarter ($p < 0.001$), mirroring the highly significant positive trajectory found in the original paper.\n\n## 3. Dynamic Event Study\n\nTo understand how this effect evolves over time and to check for pre-treatment parallel trends, we estimate an event study specification. We interact the treatment indicator with each calendar quarter, omitting Quarter 3 (the period immediately prior to randomization) as our reference group.\n\n\n::: {.cell}\n\n```{.r .cell-code}\n# Run the event study model\n# i() is a special fixest function that creates interactions and handles factors\nes_model <- feols(\n  days_with_family ~ treated +\n    i(quarter) +\n    i(quarter, treated, ref = 3) +\n    female +\n    age_group +\n    region,\n  data = panel_data,\n  cluster = ~child_id\n)\n\n# Extract the coefficients for plotting\nes_results <- broom::tidy(es_model, conf.int = TRUE) %>%\n  # Fix: Look for both words separately so it catches any naming format\n  filter(grepl(\"quarter\", term) & grepl(\"treated\", term)) %>%\n  # Clean up the term column to just get the numeric quarter\n  mutate(\n    quarter = as.numeric(str_extract(term, \"\\\\d+\")),\n    is_post = ifelse(quarter >= 4, \"Post-Treatment\", \"Pre-Treatment\")\n  ) %>%\n  # Add the reference quarter (Q3) back in with 0s for the plot\n  bind_rows(\n    tibble(\n      term = \"reference\",\n      estimate = 0,\n      std.error = 0,\n      conf.low = 0,\n      conf.high = 0,\n      quarter = 3,\n      is_post = \"Pre-Treatment\"\n    )\n  ) %>%\n  arrange(quarter)\n```\n:::\n\n\n## 4. Interactive Event Study Visualization\n\nWe use ggplot2 and plotly to create an interactive event study graph.\n\n\n::: {.cell}\n\n```{.r .cell-code}\n# Build the base ggplot\np <- ggplot(es_results, aes(x = quarter, y = estimate, color = is_post)) +\n  geom_hline(yintercept = 0, linetype = \"dashed\", color = \"black\", alpha = 0.6) +\n  geom_vline(xintercept = 3.5, linetype = \"solid\", color = \"darkred\", alpha = 0.8) +\n  geom_point(size = 3) +\n  geom_errorbar(aes(ymin = conf.low, ymax = conf.high), width = 0.2, linewidth = 1) +\n  scale_color_manual(values = c(\"Pre-Treatment\" = \"gray50\", \"Post-Treatment\" = \"steelblue4\")) +\n  scale_x_continuous(breaks = 1:8, labels = paste0(\"Q\", 1:8)) +\n  labs(\n    title = \"Event Study: Effect of Mi Abogado on Days Living with Family\",\n    subtitle = \"Quarter 3 serves as the reference period.\",\n    x = \"Quarter Relative to Randomization\",\n    y = \"Estimated Effect (Days)\",\n    color = \"Period\"\n  ) +\n  theme_minimal() +\n  theme(\n    legend.position = \"bottom\",\n    plot.title = element_text(face = \"bold\", size = 14)\n  )\n\n# Convert to an interactive plotly object\nggplotly(p, tooltip = c(\"x\", \"y\", \"ymin\", \"ymax\")) %>%\n  layout(legend = list(orientation = \"h\", x = 0.3, y = -0.2))\n```\n\n::: {.cell-output-display}\n\n```{=html}\n<div class=\"plotly html-widget html-fill-item\" id=\"htmlwidget-e5a76a380f282071e54d\" style=\"width:100%;height:464px;\"></div>\n<script type=\"application/json\" data-for=\"htmlwidget-e5a76a380f282071e54d\">{\"x\":{\"data\":[{\"x\":[0.54000000000000004,8.4599999999999991],\"y\":[0,0],\"text\":\"\",\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"width\":1.8897637795275593,\"color\":\"rgba(0,0,0,0.6)\",\"dash\":\"dash\"},\"hoveron\":\"points\",\"showlegend\":false,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"x\":[3.5,3.5],\"y\":[-1.548554252461414,6.472086029639442],\"text\":\"\",\"type\":\"scatter\",\"mode\":\"lines\",\"line\":{\"width\":1.8897637795275593,\"color\":\"rgba(139,0,0,0.8)\",\"dash\":\"solid\"},\"hoveron\":\"points\",\"showlegend\":false,\"xaxis\":\"x\",\"yaxis\":\"y\",\"hoverinfo\":\"text\",\"frame\":null},{\"x\":[4,5,6,7,8],\"y\":[4